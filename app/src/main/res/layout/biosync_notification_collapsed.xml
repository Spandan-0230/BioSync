<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <!-- Top Header Row: Brand Title + Streak & Readiness Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_kcal" />

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="BIOSYNC 6-PILLAR LIVE HUD"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_streak_badge_bg"
            android:fontFamily="monospace"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="🔥 0D • 0% READY"
            android:textColor="#FFD166"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Crisp 6-Pillar Compact Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="6">

        <TextView
            android:id="@+id/notif_collapsed_cal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="CAL 0%"
            android:textColor="#FFB703"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_pro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="PRO 0%"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_steps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="STP 0%"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_carbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="CRB 0%"
            android:textColor="#FACC15"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_fats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="FAT 0%"
            android:textColor="#FB7185"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="H2O 0%"
            android:textColor="#06B6D4"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
