<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <!-- High-DPI Adaptive 3D Obsidian Telemetry Canvas (Auto-resizes to any launcher cell size & resolution) -->
    <ImageView
        android:id="@+id/widget_telemetry_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitXY" />

    <!-- Interactive Touch Overlay:
         Top 70% opens Dashboard
         Bottom 30% Dock has 2 Tactile Rows (Widget-Exclusive +250 / +500 / +1,000 Steps + +250ml / +500ml H2O + Open HUD) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100">

        <FrameLayout
            android:id="@+id/widget_btn_open_dashboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="70"
            android:background="@android:color/transparent"
            android:contentDescription="Open BioSync Dashboard" />

        <!-- Dock Row 1: Widget-Only Step Quick-Add (+250 Steps | +500 Steps | +1,000 Steps) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:weightSum="3">

            <FrameLayout
                android:id="@+id/widget_btn_steps_250"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Add 250 Steps from Widget" />

            <FrameLayout
                android:id="@+id/widget_btn_steps_500"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Add 500 Steps from Widget" />

            <FrameLayout
                android:id="@+id/widget_btn_steps_1000"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Add 1000 Steps from Widget" />
        </LinearLayout>

        <!-- Dock Row 2: Hydration Quick-Add (+250ml H2O | +500ml H2O | Open HUD) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:weightSum="3">

            <FrameLayout
                android:id="@+id/widget_btn_water_250"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Log 250ml Hydration" />

            <FrameLayout
                android:id="@+id/widget_btn_water_500"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Log 500ml Hydration" />

            <FrameLayout
                android:id="@+id/widget_btn_sync_steps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Sync Live Steps &amp; Open App" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
